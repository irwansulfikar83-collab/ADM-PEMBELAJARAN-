rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      // School Profile documents
      match /profiles/{profileId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(profileId) 
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) 
          && isValidId(profileId) 
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(profileId);
      }

      // Saved Modul Ajar documents
      match /modul_ajar/{modulId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) 
          && isValidId(modulId) 
          && request.resource.data.userId == userId;
        allow update: if isOwner(userId) 
          && isValidId(modulId) 
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(modulId);
      }
    }
  }
}
